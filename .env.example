# EcoLith Platform Environment Variables (Vercel & Local Node.js)
# NOTE: EcoLith is strictly BYOK (Bring Your Own Key, Gemini only).
# There is NO platform Gemini API key anywhere in the system.

PORT=3000
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
# Master secret for user key AES-256-GCM encryption at rest (generate: openssl rand -base64 32)
KEY_ENCRYPTION_SECRET=your_32_byte_base64_master_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only service-role key (used exclusively in backend/api for vault & admin functions)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Allowed frontend origin (e.g. https://your-app.vercel.app or http://localhost:5500)
ALLOWED_ORIGIN=http://localhost:5500
